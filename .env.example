# Read-only HubSpot Service Key for the prospect portal. Never commit a real value.
HUBSPOT_SERVICE_KEY=
PROSPECT_NAME=

# Catch-Log-Fail error reporting (PPC Central Error Router)
ERROR_ROUTER_URL=
FLOW_ID=
FLOW_NAME=HubSpot API Audit
PLATFORM_NAME=LOCAL_SCRIPT

# OAuth (public app) mode: hubspot-audit run --auth oauth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8765/callback
# Optional: skips the interactive install when a hosted receiver already holds a token
HUBSPOT_REFRESH_TOKEN=

# Hosted receiver (Netlify): run --auth oauth --state <state>
TOKEN_RECEIVER_URL=
STATE_SIGNING_SECRET=
TOKEN_FETCH_SECRET=
# Default: ~/.hubspot-audit/token_private.pem (created by `hubspot-audit keygen`)
TOKEN_PRIVATE_KEY_PATH=

# Client list (default: ./clients.toml). Copy clients.example.toml to start.
HUBSPOT_AUDIT_CONFIG=
