    "permittedUrls": {
      "fetch": [],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "REPLACE-WITH-SUPPORT-EMAIL",
      "documentationUrl": "https://REPLACE-WITH-DOCS-URL",
      "supportUrl": "https://REPLACE-WITH-SUPPORT-URL",
      "supportPhone": "+10000000000"
    }
  }
}
